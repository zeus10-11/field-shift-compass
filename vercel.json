{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "installCommand": "uv pip install --system -r requirements.txt",
  "buildCommand": "python scripts/build.py",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/agronomist", "dest": "/agronomist.html" }
  ]
}
